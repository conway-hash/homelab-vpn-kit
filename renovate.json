{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Headscale image version, pinned as a var rather than in the (templated) docker-compose file Renovate can't parse.",
      "managerFilePatterns": [
        "/^ansible/group_vars/coordination_server/vars\\.yml$/"
      ],
      "matchStrings": [
        "headscale_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/headscale/headscale"
    },
    {
      "customType": "regex",
      "description": "Headplane image version, same reasoning.",
      "managerFilePatterns": [
        "/^ansible/group_vars/coordination_server/vars\\.yml$/"
      ],
      "matchStrings": [
        "headplane_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/tale/headplane"
    },
    {
      "customType": "regex",
      "description": "Caddy image version on the coordination server. Pinned separately from the reverse proxy server's own Caddy — independently upgradable, deliberately not shared.",
      "managerFilePatterns": [
        "/^ansible/group_vars/coordination_server/vars\\.yml$/"
      ],
      "matchStrings": [
        "caddy_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "caddy"
    },
    {
      "customType": "regex",
      "description": "Caddy image version on the reverse proxy server VM. Separate pin from the coordination server's Caddy — see that entry's note.",
      "managerFilePatterns": [
        "/^ansible/group_vars/reverse_proxy_server/vars\\.yml$/"
      ],
      "matchStrings": [
        "caddy_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "caddy"
    }
  ]
}
