# Managed by Ansible — edits will be overwritten
{
	email {{ acme_email }}
}

(dns_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

# Bare base domain — also doubles as a reachability smoke test (see
# .github/workflows/deploy.yml).
{{ tailnet_base_domain }} {
	import dns_cloudflare
	respond "proxy is up"
}

# One wildcard cert covers every device below — current and future ones,
# with zero extra ACME work when you add a new block.
*.{{ tailnet_base_domain }} {
	import dns_cloudflare

	# Add one @matcher + handle block per device you want fronted.
	# Example — Vaultwarden on a VM at 100.64.0.5:
	#
	# @vault host vault.{{ tailnet_base_domain }}
	# handle @vault {
	#     reverse_proxy 100.64.0.5:80
	# }

	handle {
		respond "no route configured for this name yet" 404
	}
}
