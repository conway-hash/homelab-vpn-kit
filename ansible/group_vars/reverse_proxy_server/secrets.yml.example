# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from GitHub Secrets and
# never touches the repo; see .github/workflows/deploy.yml.

# DNS-01 needs API access to the real conway-hash.com zone to prove
# ownership of names under {{ tailnet_base_domain }}. Scope this token to
# Zone:DNS:Edit on the conway-hash.com zone only — see SETUP.md.
cloudflare_api_token: "CHANGEME"

# REQUIRED — a Headscale pre-auth key for the edge VM's own tailnet join.
# Must be non-ephemeral (this node persists) — see SETUP.md, step 11.
tailscale_authkey: "CHANGEME"
